# Sparky Stereo OS build of Waterfox, x86_64 Linux release profile.
#
# The options are Waterfox's own release profile for Linux
# (waterfox/build/mozconfig-x86_64-pc-linux-gnu with mozconfig.common, the
# WFX_RELEASE branch), written out in full because mach rejects an option
# that a sourced file already set the other way. Each difference from
# Waterfox's profile carries its reason on the line before it.

clang22="$HOME/.mozbuild/clang-22"
export PATH="$clang22/bin:$PATH"
export CC="$clang22/bin/clang"
export CXX="$clang22/bin/clang++"
export HOST_CC="$CC"
export HOST_CXX="$CXX"

ac_add_options --target=x86_64-pc-linux-gnu
ac_add_options --with-wasi-sysroot="$HOME/.mozbuild/sysroot-wasm32-wasi"
ac_add_options --enable-bootstrap=-clang,-sysroot-wasm32-wasi,-sccache
ac_add_options --enable-application=browser

ac_add_options --enable-lto
ac_add_options --enable-release
ac_add_options --enable-rust-simd
ac_add_options RUSTC_OPT_LEVEL=3
export MOZILLA_OFFICIAL=1
# The edition's packages target x86-64-v3 (Waterfox: x86-64-v2, tuned for
# Haswell, which is x86-64-v3).
ac_add_options --enable-optimize="-march=x86-64-v3 -O3 -w"
export RUSTFLAGS="$RUSTFLAGS -Ctarget-cpu=x86-64-v3"
# No profile-guided optimisation: it builds the browser twice and runs it
# in between, hours at the four threads a partner lane may use.

ac_add_options --disable-crashreporter
ac_add_options --disable-debug
ac_add_options --disable-dmd
ac_add_options --disable-geckodriver
ac_add_options --disable-profiling
ac_add_options --disable-tests
ac_add_options --enable-alsa
ac_add_options --enable-pulseaudio
ac_add_options --enable-linker=lld
ac_add_options --enable-strip
ac_add_options --enable-install-strip
ac_add_options --enable-update-channel=release
# apt updates the package, as Debian builds Firefox: no in-app updater.
ac_add_options --disable-updater

# A brand of our own until BrowserWorks agrees otherwise: their terms
# (v2.0) say a modified build must not carry Waterfox branding.
ac_add_options --with-app-basename=SparkyStereoBrowser
ac_add_options --with-app-name=sparky-stereo-browser
ac_add_options --with-branding=browser/branding/sparky-stereo
ac_add_options --without-onnx-runtime
ac_add_options --with-l10n-base="$topsrcdir"/waterfox/browser/locales

export MOZ_INCLUDE_SOURCE_INFO=1
export MOZ_NO_PIE_COMPAT=1
export MOZ_STDCXX_COMPAT=1
export MOZ_REQUIRE_SIGNING=
export MOZ_TELEMETRY_REPORTING=

mk_add_options MOZ_OBJDIR=@TOPSRCDIR@/obj-x86_64-pc-linux-gnu
mk_add_options MOZ_PARALLEL_BUILD=4
