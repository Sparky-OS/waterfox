From 5eadaccb9691934e7864a5db0b789d037ae17159 Mon Sep 17 00:00:00 2001
From: Daniel Campos Ramos <Capitain_Jack@yahoo.com>
Date: Mon, 12 Oct 2026 21:05:16 -0300
Subject: [PATCH 01/12] DMABufSurface: carry the stereo mode of the picture it
 holds

A DMABuf surface may hold the two views of a stereoscopic picture, packed
in one frame. Keep that packing (Gecko's StereoMode, which the WebM
demuxer already reads from the Matroska StereoMode element) on the
surface and carry it across processes in SurfaceDescriptorDMABuf, so the
compositor can tell a stereo picture from a flat one.

Assisted-by: Claude Opus 5.5 via Claude Code
---
 gfx/layers/ipc/LayersSurfaces.ipdlh      | 1 +
 widget/gtk/DMABufSurface.cpp             | 6 ++++--
 widget/gtk/DMABufSurface.h               | 8 ++++++++
 widget/tests/gtest/TestDMABufSurface.cpp | 9 ++++++---
 4 files changed, 19 insertions(+), 5 deletions(-)

diff --git a/gfx/layers/ipc/LayersSurfaces.ipdlh b/gfx/layers/ipc/LayersSurfaces.ipdlh
index 897b97d1c8..f6d1519427 100644
--- a/gfx/layers/ipc/LayersSurfaces.ipdlh
+++ b/gfx/layers/ipc/LayersSurfaces.ipdlh
@@ -100,6 +100,7 @@ namespace layers {
   FileDescriptor[] refCount;
   nullable FileHandleWrapper semaphoreFd;
   bool semaphoreFdIsSyncFd;
+  StereoMode stereoMode;
 };
 
 [Comparable] struct SurfaceTextureDescriptor {
diff --git a/widget/gtk/DMABufSurface.cpp b/widget/gtk/DMABufSurface.cpp
index 4f88f0c247..be89904e42 100644
--- a/widget/gtk/DMABufSurface.cpp
+++ b/widget/gtk/DMABufSurface.cpp
@@ -1131,6 +1131,7 @@ bool DMABufSurfaceRGBA::ImportSurfaceDescriptor(
   mBufferModifier = desc.modifier()[0];
   mUID = desc.uid();
   mPID = desc.pid();
+  mStereoMode = desc.stereoMode();
 
   LOGDMABUF(
       "DMABufSurfaceRGBA::ImportSurfaceDescriptor() UID %d size %d x %d\n",
@@ -1205,7 +1206,7 @@ bool DMABufSurfaceRGBA::Serialize(
       mColorRange, mozilla::gfx::ColorSpace2::UNKNOWN,
       mozilla::gfx::TransferFunction::Default, 0, fenceFDs, mUID,
       mCanRecycle ? getpid() : 0, refCountFDs,
-      /* semaphoreFd */ nullptr, /* semaphoreFdIsSyncFd */ false);
+      /* semaphoreFd */ nullptr, /* semaphoreFdIsSyncFd */ false, mStereoMode);
   return true;
 }
 
@@ -2081,6 +2082,7 @@ bool DMABufSurfaceYUV::ImportSurfaceDescriptor(
   mGbmBufferFlags = aDesc.flags();
   mUID = aDesc.uid();
   mPID = aDesc.pid();
+  mStereoMode = aDesc.stereoMode();
 
   LOGDMABUF("DMABufSurfaceYUV::ImportSurfaceDescriptor() UID %d", mUID);
 
@@ -2158,7 +2160,7 @@ bool DMABufSurfaceYUV::Serialize(
       height, widthBytes, heightBytes, format, strides, offsets,
       GetYUVColorSpace(), mColorRange, mColorPrimaries, mTransferFunction,
       mWPChromaLocation, fenceFDs, mUID, mCanRecycle ? getpid() : 0,
-      refCountFDs, mSemaphoreFd, mSemaphoreFdIsSyncFd);
+      refCountFDs, mSemaphoreFd, mSemaphoreFdIsSyncFd, mStereoMode);
   return true;
 }
 
diff --git a/widget/gtk/DMABufSurface.h b/widget/gtk/DMABufSurface.h
index 86e6127023..3d74e0652f 100644
--- a/widget/gtk/DMABufSurface.h
+++ b/widget/gtk/DMABufSurface.h
@@ -168,6 +168,12 @@ class DMABufSurface {
     mColorRange = aColorRange;
   };
 
+  // How the surface holds the two views of a stereoscopic picture, if any.
+  void SetStereoMode(mozilla::StereoMode aStereoMode) {
+    mStereoMode = aStereoMode;
+  }
+  mozilla::StereoMode GetStereoMode() const { return mStereoMode; }
+
   void FenceSet();
   void FenceWait();
   static void FenceWait(RefPtr<mozilla::gl::GLContext> aGL,
@@ -337,6 +343,8 @@ class DMABufSurface {
 
   mozilla::gfx::ColorRange mColorRange = mozilla::gfx::ColorRange::LIMITED;
 
+  mozilla::StereoMode mStereoMode = mozilla::StereoMode::MONO;
+
   mozilla::gfx::YUVColorSpace mColorSpace =
       mozilla::gfx::YUVColorSpace::Default;
   mozilla::gfx::ColorSpace2 mColorPrimaries =
diff --git a/widget/tests/gtest/TestDMABufSurface.cpp b/widget/tests/gtest/TestDMABufSurface.cpp
index 71e275fe79..e0c93d3a26 100644
--- a/widget/tests/gtest/TestDMABufSurface.cpp
+++ b/widget/tests/gtest/TestDMABufSurface.cpp
@@ -43,8 +43,8 @@ static SurfaceDescriptor MakeRGBADescriptor(RefPtr<FileHandleWrapper> fd) {
       DMABufSurface::SURFACE_RGBA, 0, modifiers, 0, fds, width, height, width,
       height, format, strides, offsets, gfx::YUVColorSpace::BT601,
       gfx::ColorRange::LIMITED, gfx::ColorSpace2::UNKNOWN,
-      gfx::TransferFunction::Default, 0, fence, 1, 0, refCount, nullptr,
-      false));
+      gfx::TransferFunction::Default, 0, fence, 1, 0, refCount, nullptr, false,
+      StereoMode::MONO));
 }
 
 // Matches what DMABufSurfaceYUV::Serialize() produces for a two-plane 128×128
@@ -67,7 +67,7 @@ static SurfaceDescriptor MakeYUVDescriptor(RefPtr<FileHandleWrapper> fd0,
       height, widthAligned, heightAligned, format, strides, offsets,
       gfx::YUVColorSpace::BT601, gfx::ColorRange::LIMITED,
       gfx::ColorSpace2::UNKNOWN, gfx::TransferFunction::Default, 0, fence, 1, 0,
-      refCount, nullptr, false));
+      refCount, nullptr, false, StereoMode::LEFT_RIGHT));
 }
 
 // Run 3 serialize → import cycles for a single-plane RGBA surface.
@@ -82,6 +82,7 @@ static void RGBARoundtrip(RefPtr<DMABufSurface> surface) {
     EXPECT_EQ(d.height()[0], 128u);
     EXPECT_EQ(d.strides()[0], 512u);
     EXPECT_EQ(d.modifier()[0], uint64_t{0});
+    EXPECT_EQ(d.stereoMode(), StereoMode::MONO);
     surface = DMABufSurface::CreateDMABufSurface(desc);
     ASSERT_NE(surface, nullptr);
     EXPECT_EQ(surface->GetWidth(), 128);
@@ -103,12 +104,14 @@ static void YUVRoundtrip(RefPtr<DMABufSurface> surface) {
     EXPECT_EQ(d.height()[1], 64u);
     EXPECT_EQ(d.format().Length(), 2u);
     EXPECT_EQ(d.modifier().Length(), 2u);
+    EXPECT_EQ(d.stereoMode(), StereoMode::LEFT_RIGHT);
     surface = DMABufSurface::CreateDMABufSurface(desc);
     ASSERT_NE(surface, nullptr);
     EXPECT_EQ(surface->GetWidth(0), 128);
     EXPECT_EQ(surface->GetHeight(0), 128);
     EXPECT_EQ(surface->GetWidth(1), 64);
     EXPECT_EQ(surface->GetHeight(1), 64);
+    EXPECT_EQ(surface->GetStereoMode(), StereoMode::LEFT_RIGHT);
   }
 }
 
