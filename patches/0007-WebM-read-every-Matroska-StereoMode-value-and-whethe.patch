From cd6b38b88e3caa07fdb3c0418daac80d7426118b Mon Sep 17 00:00:00 2001
From: Daniel Campos Ramos <Capitain_Jack@yahoo.com>
Date: Tue, 13 Oct 2026 14:54:20 -0300
Subject: [PATCH 07/18] WebM: read every Matroska StereoMode value and whether
 a view's size is given

nestegg passed on only StereoMode 0 to 3 and 11 and gave 0 for a track
without the element, so a track marked mono and an unmarked one looked the
same. It now passes on every value of RFC 9559 Table 5 (section
5.1.4.1.28.3), says when the element is absent, and says whether the
track has DisplayWidth or DisplayHeight.

For a marked track those give the size of one view (RFC 9559 section
18.10), and Gecko already shows the track at that size: the mark comes
with the size of a view. Without them the views may be half or full
size, and the shape of the picture decides later.

Assisted-by: Claude Opus 5.5 via Claude Code
---
 dom/media/webm/WebMDemuxer.cpp             | 45 ++++++++++++++--------
 media/libnestegg/include/nestegg/nestegg.h | 23 +++++++++--
 media/libnestegg/src/nestegg.c             | 15 +++++---
 3 files changed, 58 insertions(+), 25 deletions(-)

diff --git a/dom/media/webm/WebMDemuxer.cpp b/dom/media/webm/WebMDemuxer.cpp
index a5486dcf8f..0db5746bf3 100644
--- a/dom/media/webm/WebMDemuxer.cpp
+++ b/dom/media/webm/WebMDemuxer.cpp
@@ -562,22 +562,35 @@ nsresult WebMDemuxer::ReadMetadata() {
       mInfo.mVideo.SetImageRect(pictureRect);
       mInfo.mVideo.SetAlpha(params.alpha_mode);
 
-      switch (params.stereo_mode) {
-        case NESTEGG_VIDEO_MONO:
-          mInfo.mVideo.mStereoMode = StereoMode::MONO;
-          break;
-        case NESTEGG_VIDEO_STEREO_LEFT_RIGHT:
-          mInfo.mVideo.mStereoMode = StereoMode::LEFT_RIGHT;
-          break;
-        case NESTEGG_VIDEO_STEREO_BOTTOM_TOP:
-          mInfo.mVideo.mStereoMode = StereoMode::BOTTOM_TOP;
-          break;
-        case NESTEGG_VIDEO_STEREO_TOP_BOTTOM:
-          mInfo.mVideo.mStereoMode = StereoMode::TOP_BOTTOM;
-          break;
-        case NESTEGG_VIDEO_STEREO_RIGHT_LEFT:
-          mInfo.mVideo.mStereoMode = StereoMode::RIGHT_LEFT;
-          break;
+      // Matroska's StereoMode (RFC 9559 section 5.1.4.1.28.3, Table 5). A
+      // marked track's DisplayWidth and DisplayHeight are those of one view
+      // (section 18.10): with them, the mark comes with the size of a view;
+      // without them, the views may be half or full size.
+      static constexpr StereoMode kStereoModes[] = {
+          StereoMode::MONO,
+          StereoMode::LEFT_RIGHT,
+          StereoMode::BOTTOM_TOP,
+          StereoMode::TOP_BOTTOM,
+          StereoMode::CHECKERBOARD_RIGHT_FIRST,
+          StereoMode::CHECKERBOARD_LEFT_FIRST,
+          StereoMode::ROWS_RIGHT_FIRST,
+          StereoMode::ROWS_LEFT_FIRST,
+          StereoMode::COLUMNS_RIGHT_FIRST,
+          StereoMode::COLUMNS_LEFT_FIRST,
+          StereoMode::ANAGLYPH_CYAN_RED,
+          StereoMode::RIGHT_LEFT,
+          StereoMode::ANAGLYPH_GREEN_MAGENTA,
+          StereoMode::LACED_LEFT_FIRST,
+          StereoMode::LACED_RIGHT_FIRST,
+      };
+      if (params.stereo_mode < std::size(kStereoModes)) {
+        mInfo.mVideo.mStereoMode = kStereoModes[params.stereo_mode];
+        mInfo.mVideo.mStereoSource = params.display_size_set
+                                         ? StereoSource::CONTAINER_SIZED
+                                         : StereoSource::CONTAINER;
+      } else {
+        mInfo.mVideo.mStereoMode = StereoMode::MONO;
+        mInfo.mVideo.mStereoSource = StereoSource::NONE;
       }
       uint64_t duration = 0;
       r = nestegg_duration(context, &duration);
diff --git a/media/libnestegg/include/nestegg/nestegg.h b/media/libnestegg/include/nestegg/nestegg.h
index 78da401c86..f09014e2fe 100644
--- a/media/libnestegg/include/nestegg/nestegg.h
+++ b/media/libnestegg/include/nestegg/nestegg.h
@@ -85,6 +85,17 @@ extern "C" {
 #define NESTEGG_VIDEO_STEREO_BOTTOM_TOP 2 /**< Track is top-bottom stereo video.  Right first. */
 #define NESTEGG_VIDEO_STEREO_TOP_BOTTOM 3 /**< Track is top-bottom stereo video.  Left first. */
 #define NESTEGG_VIDEO_STEREO_RIGHT_LEFT 11 /**< Track is side-by-side stereo video.  Right first. */
+#define NESTEGG_VIDEO_STEREO_CHECKERBOARD_RIGHT_LEFT 4 /**< Checkerboard.  Right first. */
+#define NESTEGG_VIDEO_STEREO_CHECKERBOARD_LEFT_RIGHT 5 /**< Checkerboard.  Left first. */
+#define NESTEGG_VIDEO_STEREO_ROWS_RIGHT_LEFT 6 /**< Row interleaved.  Right first. */
+#define NESTEGG_VIDEO_STEREO_ROWS_LEFT_RIGHT 7 /**< Row interleaved.  Left first. */
+#define NESTEGG_VIDEO_STEREO_COLUMNS_RIGHT_LEFT 8 /**< Column interleaved.  Right first. */
+#define NESTEGG_VIDEO_STEREO_COLUMNS_LEFT_RIGHT 9 /**< Column interleaved.  Left first. */
+#define NESTEGG_VIDEO_STEREO_ANAGLYPH_CYAN_RED 10 /**< Anaglyph, cyan and red. */
+#define NESTEGG_VIDEO_STEREO_ANAGLYPH_GREEN_MAGENTA 12 /**< Anaglyph, green and magenta. */
+#define NESTEGG_VIDEO_STEREO_LACED_LEFT_RIGHT 13 /**< Both eyes laced in one block.  Left first. */
+#define NESTEGG_VIDEO_STEREO_LACED_RIGHT_LEFT 14 /**< Both eyes laced in one block.  Right first. */
+#define NESTEGG_VIDEO_STEREO_ABSENT 0xffffffff /**< The track has no StereoMode element. */
 
 #define NESTEGG_VIDEO_PROJECTION_RECTANGULAR     0 /**< Track uses rectangular projection type. */
 #define NESTEGG_VIDEO_PROJECTION_EQUIRECTANGULAR 1 /**< Track uses equirectangular projection type. */
@@ -152,14 +163,18 @@ typedef struct {
 
 /** Parameters specific to a video track. */
 typedef struct {
-  unsigned int stereo_mode;    /**< Video mode.  One of #NESTEGG_VIDEO_MONO,
-                                    #NESTEGG_VIDEO_STEREO_LEFT_RIGHT,
-                                    #NESTEGG_VIDEO_STEREO_BOTTOM_TOP, or
-                                    #NESTEGG_VIDEO_STEREO_TOP_BOTTOM. */
+  unsigned int stereo_mode;    /**< Video mode.  One of the values of the
+                                    StereoMode element (RFC 9559, Table 5:
+                                    #NESTEGG_VIDEO_MONO to
+                                    #NESTEGG_VIDEO_STEREO_LACED_RIGHT_LEFT),
+                                    or #NESTEGG_VIDEO_STEREO_ABSENT when the
+                                    track has no StereoMode element. */
   unsigned int width;          /**< Width of the video frame in pixels. */
   unsigned int height;         /**< Height of the video frame in pixels. */
   unsigned int display_width;  /**< Display width of the video frame in pixels. */
   unsigned int display_height; /**< Display height of the video frame in pixels. */
+  unsigned int display_size_set; /**< 1 if the track has a DisplayWidth or
+                                     DisplayHeight element, otherwise 0. */
   unsigned int crop_bottom;    /**< Pixels to crop from the bottom of the frame. */
   unsigned int crop_top;       /**< Pixels to crop from the top of the frame. */
   unsigned int crop_left;      /**< Pixels to crop from the left of the frame. */
diff --git a/media/libnestegg/src/nestegg.c b/media/libnestegg/src/nestegg.c
index fe937af2d4..7d2b6c0bb2 100644
--- a/media/libnestegg/src/nestegg.c
+++ b/media/libnestegg/src/nestegg.c
@@ -3002,9 +3002,10 @@ nestegg_track_video_params(nestegg * ctx, unsigned int track,
     return -1;
 
   value = 0;
-  ne_get_uint(entry->video.stereo_mode, &value);
-  if (value <= NESTEGG_VIDEO_STEREO_TOP_BOTTOM ||
-      value == NESTEGG_VIDEO_STEREO_RIGHT_LEFT)
+  if (ne_get_uint(entry->video.stereo_mode, &value) != 0 ||
+      value > NESTEGG_VIDEO_STEREO_LACED_RIGHT_LEFT)
+    params->stereo_mode = NESTEGG_VIDEO_STEREO_ABSENT;
+  else
     params->stereo_mode = value;
 
   value = 0;
@@ -3035,12 +3036,16 @@ nestegg_track_video_params(nestegg * ctx, unsigned int track,
   ne_get_uint(entry->video.pixel_crop_right, &value);
   params->crop_right = value;
 
+  params->display_size_set = 0;
+
   value = params->width;
-  ne_get_uint(entry->video.display_width, &value);
+  if (ne_get_uint(entry->video.display_width, &value) == 0)
+    params->display_size_set = 1;
   params->display_width = value;
 
   value = params->height;
-  ne_get_uint(entry->video.display_height, &value);
+  if (ne_get_uint(entry->video.display_height, &value) == 0)
+    params->display_size_set = 1;
   params->display_height = value;
 
   value = 2;
-- 
