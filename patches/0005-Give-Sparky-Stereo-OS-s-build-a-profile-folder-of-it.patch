From 80c002d21a812bfe54f0c4b49a9a1155bdec1422 Mon Sep 17 00:00:00 2001
From: Daniel Campos Ramos <Capitain_Jack@yahoo.com>
Date: Mon, 12 Oct 2026 21:05:20 -0300
Subject: [PATCH 05/25] Give Sparky Stereo OS's build a profile folder of its
 own

The profile folder follows MOZ_APP_PROFILE: ~/.sparky-stereo-browser
instead of Waterfox's own, so that this build and an upstream Waterfox
never share a profile.

Assisted-by: Claude Opus 5.5 via Claude Code
---
 waterfox/moz.configure | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/waterfox/moz.configure b/waterfox/moz.configure
index fe4b5abe04..fc38243a92 100644
--- a/waterfox/moz.configure
+++ b/waterfox/moz.configure
@@ -5,5 +5,5 @@
 # file, You can obtain one at http://mozilla.org/MPL/2.0/.
 
 imply_option("MOZ_APP_UA_NAME", "Firefox")
-imply_option("MOZ_APP_PROFILE", "Waterfox")
+imply_option("MOZ_APP_PROFILE", "sparky-stereo-browser")
 imply_option("--with-distribution-id", "net.waterfox")
-- 
