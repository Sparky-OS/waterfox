diff --git a/gfx/layers/ImageTypes.h b/gfx/layers/ImageTypes.h
index 0a6e9bb781..af3618ceeb 100644
--- a/gfx/layers/ImageTypes.h
+++ b/gfx/layers/ImageTypes.h
@@ -153,18 +153,37 @@ enum class StereoSource : uint8_t {
   MAX,
