From 71e60fc80ff72ad4b5d25ab7465187c65afabf16 Mon Sep 17 00:00:00 2001
From: Daniel Campos Ramos <Capitain_Jack@yahoo.com>
Date: Wed, 14 Oct 2026 02:49:48 -0300
Subject: [PATCH 14/18] FFmpegVideoDecoder: frames decoded in software keep
 their SEI mark

Frames decoded in software reach the compositor as YCbCr buffers, either
copied (VideoData::CreateAndCopyData, which took the stream's VideoInfo)
or decoded straight into shared memory. Both now carry the frame's own
mark, the frame packing SEI (H.264 D.2.26, H.265 D.3.16), before the
container's. The copy takes a VideoInfo with the frame's StereoMode and
source. A frame decoded into shared memory sets its PlanarYCbCrImage's
mode (PlanarYCbCrImage::SetStereoMode), since the SEI comes with the
decoded frame, after its buffer was allocated.

Assisted-by: Claude Opus 5.5 via Claude Code
---
 dom/media/platforms/ffmpeg/FFmpegVideoDecoder.cpp | 10 +++++++++-
 gfx/layers/ImageContainer.h                       |  4 ++++
 2 files changed, 13 insertions(+), 1 deletion(-)

diff --git a/dom/media/platforms/ffmpeg/FFmpegVideoDecoder.cpp b/dom/media/platforms/ffmpeg/FFmpegVideoDecoder.cpp
index a73dcf8f36..ac1fe3d4e0 100644
--- a/dom/media/platforms/ffmpeg/FFmpegVideoDecoder.cpp
+++ b/dom/media/platforms/ffmpeg/FFmpegVideoDecoder.cpp
@@ -2088,6 +2088,9 @@ MediaResult FFmpegVideoDecoder<LIBAV_VER>::CreateImage(
         mLib->av_buffer_get_opaque(mFrame->buf[0]));
     MOZ_ASSERT(wrapper);
     FFMPEG_LOGV("Create a video data from a shmem image={}", fmt::ptr(wrapper));
+    if (PlanarYCbCrImage* planar = wrapper->AsImage()->AsPlanarYCbCrImage()) {
+      planar->SetStereoMode(FrameStereoMode());
+    }
     v = VideoData::CreateFromImage(
         mInfo.mDisplay, aOffset, TimeUnit::FromMicroseconds(aPts),
         TimeUnit::FromMicroseconds(aDuration), wrapper->AsImage(),
@@ -2147,9 +2150,14 @@ MediaResult FFmpegVideoDecoder<LIBAV_VER>::CreateImage(
         return ret;
       }
     }
+    // The frame's own stereo mark (the frame packing SEI) before the
+    // container's.
+    VideoInfo info = mInfo;
+    info.mStereoMode = FrameStereoMode();
+    info.mStereoSource = FrameStereoSource();
     Result<already_AddRefed<VideoData>, MediaResult> r =
         VideoData::CreateAndCopyData(
-            mInfo, mImageContainer, aOffset, TimeUnit::FromMicroseconds(aPts),
+            info, mImageContainer, aOffset, TimeUnit::FromMicroseconds(aPts),
             TimeUnit::FromMicroseconds(aDuration), b, IsKeyFrame(mFrame),
             TimeUnit::FromMicroseconds(mFrame->pkt_dts),
             mInfo.ScaledImageRect(mFrame->width, mFrame->height),
diff --git a/gfx/layers/ImageContainer.h b/gfx/layers/ImageContainer.h
index c9eeb5befc..b9c954b86f 100644
--- a/gfx/layers/ImageContainer.h
+++ b/gfx/layers/ImageContainer.h
@@ -907,6 +907,10 @@ class PlanarYCbCrImage : public Image {
    */
   virtual const Data* GetData() const { return &mData; }
 
+  // The picture's stereo mode, once the decoder knows it for this frame (the
+  // frame packing SEI comes with the decoded frame, after its buffer).
+  void SetStereoMode(StereoMode aMode) { mData.mStereoMode = aMode; }
+
   /**
    * Return the number of bytes of heap memory used to store this image.
    */
