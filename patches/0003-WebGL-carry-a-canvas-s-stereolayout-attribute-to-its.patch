From 670dc044614312c4d180c4584c11b1ac5cd0ff8b Mon Sep 17 00:00:00 2001
From: Daniel Campos Ramos <Capitain_Jack@yahoo.com>
Date: Mon, 12 Oct 2026 21:05:18 -0300
Subject: [PATCH 03/25] WebGL: carry a canvas's stereolayout attribute to its
 front buffer

A page may mark a WebGL canvas as holding two views with the attribute
stereolayout="stereo-left-right" (or "stereo-top-bottom"), the names of
WebXR Layers' XRLayerLayout (WebXR Layers Level 1, section 3.2). No
specification offers this outside an XR session; the attribute is this
browser's own.

The content side reads the attribute at each present and sends it in
SwapChainOptions, in two bytes of its padding. The host sets it on the
DMABuf front buffer, whose descriptor takes it to the compositor.

Assisted-by: Claude Opus 5.5 via Claude Code
---
 dom/canvas/ClientWebGLContext.cpp | 20 ++++++++++++++++++++
 dom/canvas/WebGLContext.cpp       | 24 ++++++++++++++++++++++++
 dom/canvas/WebGLTypes.h           |  7 +++++--
 3 files changed, 49 insertions(+), 2 deletions(-)

diff --git a/dom/canvas/ClientWebGLContext.cpp b/dom/canvas/ClientWebGLContext.cpp
index 131a739bde..39672a1504 100644
--- a/dom/canvas/ClientWebGLContext.cpp
+++ b/dom/canvas/ClientWebGLContext.cpp
@@ -10,6 +10,7 @@
 
 #include "ClientWebGLExtensions.h"
 #include "HostWebGLContext.h"
+#include "ImageTypes.h"
 #include "TexUnpackBlob.h"
 #include "WebGLChild.h"
 #include "WebGLFormats.h"
@@ -28,6 +29,7 @@
 #include "mozilla/dom/BufferSourceBinding.h"
 #include "mozilla/dom/Document.h"
 #include "mozilla/dom/GeneratePlaceholderCanvasData.h"
+#include "mozilla/dom/HTMLCanvasElement.h"
 #include "mozilla/dom/ToJSValue.h"
 #include "mozilla/dom/TypedArray.h"
 #include "mozilla/dom/WebGLContextEvent.h"
@@ -522,6 +524,19 @@ webgl::SwapChainOptions ClientWebGLContext::PrepareAsyncSwapChainOptions(
   return options;
 }
 
+// The canvas's stereolayout attribute takes the names of WebXR Layers'
+// XRLayerLayout: "stereo-left-right" and "stereo-top-bottom" declare that the
+// canvas holds two views; anything else is one view.
+static StereoMode StereoModeFromLayout(const nsAString& layout) {
+  if (layout.EqualsLiteral("stereo-left-right")) {
+    return StereoMode::LEFT_RIGHT;
+  }
+  if (layout.EqualsLiteral("stereo-top-bottom")) {
+    return StereoMode::TOP_BOTTOM;
+  }
+  return StereoMode::MONO;
+}
+
 void ClientWebGLContext::Present(WebGLFramebufferJS* const xrFb,
                                  const layers::TextureType type,
                                  const bool webvr,
@@ -533,6 +548,11 @@ void ClientWebGLContext::Present(WebGLFramebufferJS* const xrFb,
   CancelAutoFlush();
   webgl::SwapChainOptions asyncOptions =
       PrepareAsyncSwapChainOptions(xrFb, webvr, options);
+  if (!xrFb && mCanvasElement) {
+    nsAutoString layout;
+    mCanvasElement->GetAttribute(u"stereolayout"_ns, layout);
+    asyncOptions.stereoMode = uint8_t(StereoModeFromLayout(layout));
+  }
   Run<RPROC(Present)>(xrFb ? xrFb->mId : 0, type, webvr, asyncOptions);
 }
 
diff --git a/dom/canvas/WebGLContext.cpp b/dom/canvas/WebGLContext.cpp
index bc700cec26..f9c38a7587 100644
--- a/dom/canvas/WebGLContext.cpp
+++ b/dom/canvas/WebGLContext.cpp
@@ -88,6 +88,10 @@
 #  include "WGLLibrary.h"
 #endif
 
+#ifdef MOZ_WIDGET_GTK
+#  include "SharedSurfaceDMABUF.h"
+#endif
+
 // Generated
 #include "mozilla/dom/WebGLRenderingContextBinding.h"
 
@@ -1054,6 +1058,21 @@ GLuint GLNameOrZero(const T& t) {
   return 0;
 }
 
+#ifdef MOZ_WIDGET_GTK
+// The front buffer carries the canvas's stereo mode to the compositor, which
+// declares it on the canvas's own surface.
+static void SetStereoMode(gl::SharedSurface* const surf,
+                          const uint8_t stereoMode) {
+  if (!surf || surf->mDesc.type != gl::SharedSurfaceType::EGLSurfaceDMABUF) {
+    return;
+  }
+  const auto mode = stereoMode < uint8_t(StereoMode::MAX)
+                        ? StereoMode(stereoMode)
+                        : StereoMode::MONO;
+  static_cast<gl::SharedSurface_DMABUF*>(surf)->mSurface->SetStereoMode(mode);
+}
+#endif
+
 // For an overview of how WebGL compositing works, see:
 // https://wiki.mozilla.org/Platform/GFX/WebGL/Compositing
 bool WebGLContext::PresentInto(gl::SwapChain& swapChain) {
@@ -1246,6 +1265,11 @@ void WebGLContext::Present(WebGLFramebuffer* const xrFb,
     EnsureContextLostRemoteTextureOwner(options);
     return;
   }
+#ifdef MOZ_WIDGET_GTK
+  if (!maybeFB) {
+    SetStereoMode(swapChain->FrontBuffer().get(), options.stereoMode);
+  }
+#endif
 
   if (useAsync) {
     PushRemoteTexture(nullptr, *swapChain, swapChain->FrontBuffer(), options);
diff --git a/dom/canvas/WebGLTypes.h b/dom/canvas/WebGLTypes.h
index 484a354303..f6f9f2542b 100644
--- a/dom/canvas/WebGLTypes.h
+++ b/dom/canvas/WebGLTypes.h
@@ -828,13 +828,16 @@ struct SwapChainOptions final {
   layers::RemoteTextureOwnerId remoteTextureOwnerId;
   bool bgra = false;
   bool forceAsyncPresent = false;
+  // A StereoMode: how the canvas holds the two views of a stereoscopic
+  // picture, as its element's stereolayout attribute declares.
+  uint8_t stereoMode = 0;
   // Pad to sizeof(u64):
-  uint16_t padding1 = 0;
+  uint8_t padding1 = 0;
   uint32_t padding2 = 0;
 
   auto MutTiedFields() {
     return std::tie(remoteTextureId, remoteTextureOwnerId, bgra,
-                    forceAsyncPresent, padding1, padding2);
+                    forceAsyncPresent, stereoMode, padding1, padding2);
   }
 };
 
